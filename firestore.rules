rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'dalanmaju25@gmail.com'
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && 
                    incoming().keys().hasAll(['email']) && 
                    incoming().keys().size() == 1 &&
                    incoming().email is string;
      allow update: if false; // admins shouldn't change emails; delete and recreate
      allow delete: if isAdmin();
    }

    // Hero Images
    match /heroImages/{imageId} {
      allow read: if true;
      allow create: if isAdmin() &&
                    incoming().keys().hasAll(['imageUrl', 'order', 'createdAt', 'updatedAt']) &&
                    incoming().keys().size() == 4 &&
                    incoming().imageUrl is string && incoming().imageUrl.size() > 0 &&
                    incoming().order is number &&
                    incoming().createdAt is number &&
                    incoming().updatedAt is number;
      allow update: if isAdmin() &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['imageUrl', 'order', 'updatedAt']) &&
                    incoming().updatedAt is number &&
                    incoming().get('imageUrl', existing().imageUrl) is string &&
                    incoming().get('order', existing().order) is number;
      allow delete: if isAdmin();
    }

    // Services
    match /services/{serviceId} {
      allow read: if true;
      allow create: if isAdmin() &&
                    incoming().keys().hasAll(['name', 'description', 'price', 'duration', 'iconType', 'isPopular', 'createdAt', 'updatedAt']) &&
                    incoming().keys().size() == 8 &&
                    incoming().name is string && incoming().name.size() > 0 &&
                    incoming().description is string &&
                    incoming().price is string &&
                    incoming().duration is string &&
                    incoming().iconType is string &&
                    incoming().isPopular is bool &&
                    incoming().createdAt is number &&
                    incoming().updatedAt is number;
      allow update: if isAdmin() &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'price', 'duration', 'iconType', 'isPopular', 'updatedAt']) &&
                    incoming().updatedAt is number;
      allow delete: if isAdmin();
    }

    // Testimonials
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if isAdmin() &&
                    incoming().keys().hasAll(['name', 'role', 'text', 'rating', 'avatarUrl', 'createdAt', 'updatedAt']) &&
                    incoming().keys().size() == 7 &&
                    incoming().name is string && incoming().name.size() > 0 &&
                    incoming().role is string &&
                    incoming().text is string &&
                    incoming().rating is number &&
                    incoming().avatarUrl is string &&
                    incoming().createdAt is number &&
                    incoming().updatedAt is number;
      allow update: if isAdmin() &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'text', 'rating', 'avatarUrl', 'updatedAt']) &&
                    incoming().updatedAt is number;
      allow delete: if isAdmin();
    }

    // Articles
    match /articles/{articleId} {
      allow read: if true;
      allow create: if isAdmin() &&
                    incoming().keys().hasAll(['title', 'excerpt', 'content', 'category', 'date', 'readTime', 'image', 'colorBox', 'createdAt', 'updatedAt']) &&
                    incoming().keys().size() == 10 &&
                    incoming().title is string && incoming().title.size() > 0 &&
                    incoming().excerpt is string &&
                    incoming().content is string &&
                    incoming().category is string &&
                    incoming().date is string &&
                    incoming().readTime is string &&
                    incoming().image is string &&
                    incoming().colorBox is string &&
                    incoming().createdAt is number &&
                    incoming().updatedAt is number;
      allow update: if isAdmin() &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['title', 'excerpt', 'content', 'category', 'date', 'readTime', 'image', 'colorBox', 'updatedAt']) &&
                    incoming().updatedAt is number;
      allow delete: if isAdmin();
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow create: if isAdmin() &&
                    incoming().keys().hasAll(['key', 'value', 'updatedAt']) &&
                    incoming().keys().size() == 3 &&
                    incoming().key is string && incoming().key.size() > 0 &&
                    incoming().value is string &&
                    incoming().updatedAt is number;
      allow update: if isAdmin() &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['value', 'updatedAt']) &&
                    incoming().updatedAt is number;
      allow delete: if isAdmin();
    }

    // Reservations
    match /reservations/{reservationId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
